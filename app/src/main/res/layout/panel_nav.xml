<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_key_pgup"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/key_pgup"
            android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_key_up"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="↑"
            android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_key_pgdn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/key_pgdn"
            android:textSize="16sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_key_left"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="←"
            android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_key_enter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/key_enter"
            android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_key_right"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="→"
            android:textSize="16sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_key_esc"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/key_esc"
            android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_key_down"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="↓"
            android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_key_tab"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/key_tab"
            android:textSize="16sp"/>
    </LinearLayout>
</LinearLayout>
