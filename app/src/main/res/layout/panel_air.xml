<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hint_air"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/color_text_secondary"/>

    <TextView
        android:id="@+id/air_no_gyro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/no_gyro"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/color_error"
        android:visibility="gone"/>

    <com.my.airmouse.input.TouchpadView
        android:id="@+id/air_pad"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pad"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/air_left"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/left_click"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/air_right"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/right_click"/>
    </LinearLayout>
</LinearLayout>
