    <!-- guide -->
    <string-array name="guide_steps_windows">
        <item>Turn on Bluetooth on your phone.</item>
        <item>Open Air mouse and tap Connect on the Devices tab. This starts the connection service.</item>
        <item>Allow the phone to be visible when asked.</item>
        <item>On your PC open Settings, then Bluetooth &amp; devices.</item>
        <item>Click Add device, choose Bluetooth, and pick your phone from the list.</item>
        <item>Confirm the pairing code on both the PC and the phone.</item>
        <item>Return to Air mouse. The status shows Connected.</item>
        <item>Open the Touchpad or Keyboard tab.</item>
        <item>Move your finger on the touchpad. The pointer should move on the PC.</item>
    </string-array>
    <string-array name="guide_steps_mac">
        <item>Turn on Bluetooth on your phone.</item>
        <item>Open Air mouse and tap Connect on the Devices tab. This starts the connection service.</item>
        <item>Allow the phone to be visible when asked.</item>
        <item>On your Mac open System Settings, then Bluetooth.</item>
        <item>Wait for your phone to show in Nearby Devices and click Connect.</item>
        <item>Confirm the pairing code on both the Mac and the phone.</item>
        <item>Return to Air mouse. The status shows Connected.</item>
        <item>Open the Touchpad or Keyboard tab.</item>
        <item>Move your finger on the touchpad. The pointer should move on the Mac.</item>
    </string-array>
